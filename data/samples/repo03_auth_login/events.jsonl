, ITERATIONS)", "return hmac.compare_digest(digest.hex(), digest_hex)", "def login(username: str, password: str, users: dict) -> bool:", "count, since = _failed.get(username, (0, 0.0))", "if count >= MAX_ATTEMPTS and time.monotonic() - since < LOCK_SECONDS:", "raise PermissionError(\"tài khoản tạm khoá, thử lại sau\")", "stored = users.get(username)", "if stored is None or not verify_password(password, stored):", "_failed[username] = (count + 1, time.monotonic())", "return False", "_failed.pop(username, None)", "return True"]}}
